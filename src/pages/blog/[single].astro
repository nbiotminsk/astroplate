---
import Base from "@/layouts/Base.astro";
import PostSingle from "@/layouts/PostSingle.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import config from "@/config/config.json";

export async function getStaticPaths() {
  const BLOG_FOLDER = "blog";
  const posts = await getSinglePage(BLOG_FOLDER);

  const paths = posts.map((post) => ({
    params: {
      single: post.id,
    },
    props: { post },
  }));
  return paths;
}

const { post } = Astro.props;
const { title, meta_title, description, image, date, author, categories, tags } =
  post.data;

const siteUrl = config.site.base_url.replace(/\/$/, "");
const articleImage = image
  ? /^https?:\/\//.test(image)
    ? image
    : `${siteUrl}${image.startsWith("/") ? image : `/${image}`}`
  : undefined;
const publishedISO = new Date(date).toISOString();
const updatedISO = post.data.updated
  ? new Date(post.data.updated).toISOString()
  : publishedISO;
---

<Base
  title={title}
  meta_title={meta_title}
  description={description}
  image={image}
  ogType="article"
  keywords={tags}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={publishedISO} />
    <meta property="article:modified_time" content={updatedISO} />
    {author && <meta property="article:author" content={author} />}
    {categories &&
      categories.map((cat: string) => (
        <meta property="article:section" content={cat} />
      ))}
    {articleImage && (
      <meta property="og:image:url" content={articleImage} />
    )}
    <meta property="og:image:alt" content={title} />
  </Fragment>
  <PostSingle post={post} />
</Base>
