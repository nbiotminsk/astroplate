---
import ImageMod from "@/components/ImageMod.astro";
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser.astro";
import JsonLd from "@/components/JsonLd.astro";
const siteUrl = "https://teleofis24.by";

const homepageEntry = await getListPage("homepage", "-index");
const homepage = homepageEntry.data as any;
---

<Base
  title={homepage.title}
  meta_title={homepage.meta_title}
  description={homepage.description}
  hideBreadcrumbs={true}
>
  <Fragment slot="head">
    <JsonLd
      type="Product"
      data={{
        name: "Радиомодем 2576 NB-IoT",
        image: `${siteUrl}/images/radiomodem-2576-photo.png`,
        description:
          "Радиомодем 2576 NB-IoT для дистанционной передачи показаний счётчиков воды на платформу UNICBOARD и УП «Минскводоканал». 2 импульсных входа, IP65/IP68, батарея 3,6 В, протокол SMP-M.",
        brand: { "@type": "Brand", name: "Nero Electronics" },
        mpn: "45.03.0001.222.00",
        sku: "radiomodem-2576",
        offers: {
          "@type": "Offer",
          url: `${siteUrl}/store/radiomodem-2576-ver-2/`,
          priceCurrency: "BYN",
          price: "483",
          priceValidUntil: "2027-12-31",
          availability: "https://schema.org/InStock",
          itemCondition: "https://schema.org/NewCondition",
          seller: {
            "@type": "Organization",
            name: "Частное предприятие «Телеофис»",
          },
        },
      }}
    />

    <JsonLd
      type="FAQPage"
      data={{
        mainEntity: homepage.faq.items.map((item: any) => ({
          "@type": "Question",
          name: item.question,
          acceptedAnswer: {
            "@type": "Answer",
            text: item.answer,
          },
        })),
      }}
    />

    <JsonLd
      type="LocalBusiness"
      data={{
        name: "ЧАСТНОЕ ПРЕДПРИЯТИЕ «ТЕЛЕОФИС»",
        image: `${siteUrl}/images/og-image.png`,
        "@id": `${siteUrl}/#organization`,
        url: siteUrl,
        telephone: "+375298462462",
        email: "info@teleofis24.by",
        priceRange: "$$",
        currenciesAccepted: "BYN",
        paymentAccepted: "ЕРИП, безналичный расчёт",
        address: {
          "@type": "PostalAddress",
          streetAddress: "ул. Макаёнка, 12г, пом. 257",
          addressLocality: "Минск",
          postalCode: "220114",
          addressCountry: "BY",
        },
        geo: {
          "@type": "GeoCoordinates",
          latitude: 53.9248,
          longitude: 27.6256,
        },
        areaServed: { "@type": "Country", name: "Беларусь" },
        openingHoursSpecification: {
          "@type": "OpeningHoursSpecification",
          dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          opens: "13:30",
          closes: "15:30",
        },
        sameAs: ["https://t.me/teleofis_by"],
      }}
    />
  </Fragment>

  <!-- Pricing -->
  <section class="section pb-16 pt-4 md:pt-6 xl:pt-6">
    <div class="container">
      <div class="mx-auto max-w-4xl text-center">
        <h1 class="mb-5 text-h3 leading-tight md:text-h2">
          Автоматическая передача показаний счётчиков воды в Минскводоканал
        </h1>
        {
          homepage.pricing.title && (
            <h2 class="mb-5 text-h4 leading-tight md:text-h3">
              {homepage.pricing.title}
            </h2>
          )
        }
        <p class="text-lg">{homepage.pricing.subtitle}</p>
        <nav class="mt-6 flex flex-wrap justify-center gap-2">
          {
            homepage.pricing.quicklinks.map((item: any) => (
              <a
                href={item.link}
                class="rounded-full px-4 py-1.5 text-sm font-semibold text-emerald-600 underline decoration-emerald-400/60 underline-offset-4 transition-colors hover:text-emerald-500 dark:text-emerald-400 dark:decoration-emerald-400/50 dark:hover:text-emerald-300"
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
      <div class="row mt-10 items-stretch gap-y-6">
        {
          homepage.pricing.cards.map((card: any, idx: number) => (
            <div
              class={`md:col-4 ${card.featured ? "lg:order-2" : ""} ${
                idx === 0 ? "lg:order-1" : idx === 2 ? "lg:order-3" : ""
              }`}
            >
              <article
                class={`info-card flex h-full flex-col text-left ${
                  card.featured
                    ? "featured-price-card relative overflow-hidden border-0 p-8 shadow-2xl md:scale-[1.04] lg:scale-[1.06]"
                    : idx === 2
                      ? "price-card price-card-gold relative overflow-hidden border-0 p-6 shadow-md"
                      : "price-card relative overflow-hidden border-0 p-6 shadow-md"
                }`}
              >
                <div class="relative z-10 flex h-full flex-col">
                  <div class="flex items-start justify-between gap-3">
                    <h2 class="text-xl font-bold text-text-dark dark:text-darkmode-text-dark">
                      {card.name}
                    </h2>
                    {card.tag && (
                      <span
                        class={`inline-flex shrink-0 rounded-full px-3 py-1 text-[11px] font-bold uppercase tracking-widest ${
                          card.featured
                            ? "border border-white/30 bg-white/15 text-white"
                            : idx === 2
                              ? "border border-amber-600/40 bg-amber-400/25 text-amber-900 dark:border-amber-400/50 dark:bg-amber-400/20 dark:text-amber-200"
                              : "border border-emerald-600/30 bg-emerald-600/10 text-emerald-700 dark:border-emerald-400/30 dark:bg-emerald-400/10 dark:text-emerald-300"
                        }`}
                      >
                        {card.tag}
                      </span>
                    )}
                  </div>
                  <div class="mt-4">
                    <p
                      class={`text-3xl font-extrabold ${
                        card.featured
                          ? "text-white"
                          : "text-text-dark dark:text-darkmode-text-dark"
                      }`}
                    >
                      {card.price}
                    </p>
                    {card.priceNote && (
                      <p
                        class={`mt-1 text-sm ${
                          card.featured
                            ? "text-white/80"
                            : "text-text-light dark:text-darkmode-text-light"
                        }`}
                      >
                        {card.priceNote}
                      </p>
                    )}
                  </div>
                  <ul class="mt-5 flex-1 space-y-2.5">
                    {card.features.map((feature: any) => {
                      const isLink =
                        typeof feature === "object" && feature !== null && feature?.link;
                      const text =
                        typeof feature === "object" && feature !== null
                          ? (feature.text ?? Object.entries(feature).map(([k, v]) => `${k}: ${v}`).join(", "))
                          : feature;
                      return (
                        <li
                          class={`flex items-start gap-2 text-sm leading-relaxed ${
                            card.featured ? "text-white/95" : ""
                          }`}
                        >
                          <svg
                            aria-hidden="true"
                            class={`mt-1 h-[1em] w-[1em] shrink-0 ${
                              card.featured
                                ? "text-white"
                                : "text-emerald-600 dark:text-emerald-400"
                            }`}
                          >
                            <use xlink:href="#icon-FaCheck" />
                          </svg>
                          {isLink ? (
                            <a
                              href={feature.link}
                              class={`font-semibold underline-offset-2 hover:underline ${
                                card.featured
                                  ? "text-white"
                                  : "text-emerald-600 dark:text-emerald-400"
                              }`}
                            >
                              {text}
                            </a>
                          ) : (
                            <span>{text}</span>
                          )}
                        </li>
                      );
                    })}
                  </ul>
                  <div class="mt-6">
                    <a
                      class={`btn w-full justify-center rounded-2xl! js-order-trigger ${
                        card.featured
                          ? "price-btn-featured shadow-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-xl active:scale-95"
                          : idx === 2
                            ? "price-btn-gold transition-all duration-300 hover:-translate-y-1 active:scale-95"
                            : "price-btn-outline transition-all duration-300 hover:-translate-y-1 active:scale-95"
                      }`}
                      href={card.cta.link}
                      data-open-order-modal
                      data-type={idx === 2 ? "yur" : "fiz"}
                      {...(card.cta.link.startsWith("http")
                        ? { target: "_blank", rel: "noopener" }
                        : {})}
                    >
                      {card.cta.label}
                      {card.cta.link.startsWith("http") && (
                        <span class="sr-only">
                          {" "}
                          (открывается в новой вкладке)
                        </span>
                      )}
                    </a>
                  </div>
                </div>
              </article>
            </div>
          ))
        }
      </div>
      <div class="row mt-10 gap-y-6">
        <div class="lg:col-7">
          <div
            class="h-full rounded-2xl border border-border bg-body p-6 dark:border-darkmode-border dark:bg-darkmode-light md:p-8"
          >
            <h2
              class="mb-4 text-xl font-bold text-text-dark dark:text-darkmode-text-dark"
            >
              Условия работы
            </h2>
            <ul
              class="grid gap-2.5 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2"
            >
              {
                homepage.pricing.terms.map((item: string) => (
                  <li class="flex items-start gap-2 text-sm leading-relaxed">
                    <svg
                      aria-hidden="true"
                      class="mt-1 h-[1em] w-[1em] shrink-0 text-primary"
                    >
                      <use xlink:href="#icon-FaCheck" />
                    </svg>
                    <span>{item}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
        <div class="lg:col-5">
          <div
            class="h-full rounded-2xl border border-emerald-300 bg-linear-to-br from-emerald-50 to-white p-6 dark:border-emerald-500/40 dark:from-darkmode-light dark:to-darkmode-body md:p-8"
          >
            <h2
              class="mb-4 flex items-center gap-2 text-xl font-semibold text-text-dark dark:text-darkmode-text-dark"
            >
              <svg
                aria-hidden="true"
                class="h-[1em] w-[1em] shrink-0"
                style="fill: #6ee7b7"
              >
                <use xlink:href="#icon-FaMoneyBillWave"></use>
              </svg>
              {homepage.pricing.payment.title}
            </h2>
            <dl class="space-y-0 text-sm leading-relaxed">
              <div
                class="flex justify-between gap-4 border-b border-border/60 py-2.5 first:pt-0 dark:border-darkmode-border/60"
              >
                <dt>Счёт</dt>
                <dd class="text-right font-semibold">
                  {homepage.pricing.payment.tabnum}
                </dd>
              </div>
              <div
                class="flex justify-between gap-4 border-b border-border/60 py-2.5 dark:border-darkmode-border/60"
              >
                <dt>Сумма</dt>
                <dd class="text-right font-semibold">
                  {homepage.pricing.payment.amount}
                </dd>
              </div>
              <div class="flex justify-between gap-4 py-2.5 last:py-0">
                <dt>Назначение</dt>
                <dd class="text-right font-semibold">
                  {homepage.pricing.payment.purpose}
                </dd>
              </div>
            </dl>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- /Pricing -->

  <!-- How it works -->
  <section class="section-sm bg-gradient" id="flow">
    <div class="container">
      <h2 class="mb-3 text-h3 text-text-dark dark:text-darkmode-text-dark">
        {homepage.flow.title}
      </h2>
      <p class="mb-8 max-w-2xl text-lg">{homepage.flow.subtitle}</p>
      <div class="row gap-y-4">
        {
          homepage.flow.steps.map((step: any, idx: number) => (
            <div class="sm:col-6 lg:col-3">
              <div class="flex h-full items-start gap-3 rounded-2xl border border-border bg-body p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md dark:border-darkmode-border dark:bg-darkmode-light">
                <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-primary bg-primary text-xs font-semibold text-white shadow-sm dark:border-darkmode-primary dark:bg-darkmode-primary dark:text-text-dark">
                  {idx + 1}
                </span>
                <div class="min-w-0">
                  <p class="flex items-center gap-2 text-sm font-semibold text-text-dark dark:text-darkmode-text-dark">
                    <svg
                      aria-hidden="true"
                      class="h-[1em] w-[1em] shrink-0 fill-current text-primary dark:text-darkmode-primary"
                    >
                      <use xlink:href={`#icon-${step.icon}`} />
                    </svg>
                    <span>{step.title}</span>
                  </p>
                  <p class="mt-1 text-xs leading-relaxed">{step.text}</p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
      <div
        class="mt-8 rounded-2xl border border-border bg-body p-6 dark:border-darkmode-border dark:bg-darkmode-light md:p-8"
      >
        <h3
          class="flex items-center gap-2 text-lg font-bold text-text-dark dark:text-darkmode-text-dark"
        >
          <svg
            aria-hidden="true"
            class="h-[1em] w-[1em] shrink-0 fill-current text-primary dark:text-darkmode-primary"
          >
            <use xlink:href="#icon-FaCogs"></use>
          </svg>
          {homepage.flow.instruction.title}
        </h3>
        <p class="mt-1 text-sm text-text-light dark:text-darkmode-text-light">
          {homepage.flow.instruction.text}
        </p>
        <ol class="mt-5 space-y-3">
          {
            homepage.flow.instruction.steps.map((item: any, idx: number) => (
              <li class="flex items-start gap-3 text-sm leading-relaxed">
                <span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-primary bg-primary text-[11px] font-semibold text-white dark:border-darkmode-primary dark:bg-darkmode-primary dark:text-text-dark">
                  {idx + 1}
                </span>
                <span>
                  {typeof item === "string"
                    ? item.replace(/<[^>]*>/g, "")
                    : item.before}
                  {typeof item !== "string" && item.link && (
                    <a href={item.link}>{item.linkText}</a>
                  )}
                  {typeof item !== "string" && item.after}
                </span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>
  <!-- /How it works -->

  <!-- Modules -->
  <section class="section-sm" id="modules">
    <div class="container">
      <h2 class="mb-3 text-h3 text-text-dark dark:text-darkmode-text-dark">
        {homepage.modules.title}
      </h2>
      <p class="mb-8 max-w-3xl text-lg">{homepage.modules.subtitle}</p>
      <div class="row gap-y-6">
        {
          homepage.modules.items.map((module: any) => (
            <div class="md:col-4">
              <article
                class="info-card module-card flex h-full flex-col p-0! text-left"
                style={`border-color: ${module.borderColor}; --card-color: ${module.borderColor}`}
              >
                <a
                  href={module.link}
                  class="group block h-50 overflow-hidden rounded-t-2xl bg-white dark:bg-darkmode-body"
                  aria-label={module.title}
                >
                  <ImageMod
                    src={module.image}
                    width={300}
                    height={225}
                    alt={module.title}
                    class="h-full w-full object-contain transition-transform duration-300 group-hover:scale-110"
                    format="webp"
                  />
                </a>
                <div class="flex flex-1 flex-col p-6">
                  <div class="flex items-center justify-between gap-3">
                    <h3 class="card-title text-text-dark dark:text-darkmode-text-dark">
                      {module.title}
                    </h3>
                    <span class="inline-flex shrink-0 rounded-full border border-primary/30 bg-primary/10 px-3 py-1 text-[11px] font-bold uppercase tracking-widest text-primary dark:border-darkmode-primary/40 dark:bg-darkmode-primary/15 dark:text-darkmode-primary">
                      {module.tag}
                    </span>
                  </div>
                  <p class="mt-1 text-sm leading-relaxed">{module.subtitle}</p>
                  <ul class="mt-4 flex-1 space-y-2.5">
                    {module.features.map((feature: string) => (
                      <li class="flex items-start gap-2 text-sm leading-relaxed">
                        <svg
                          aria-hidden="true"
                          class="mt-1 h-[1em] w-[1em] shrink-0 text-primary"
                        >
                          <use xlink:href="#icon-FaCheck" />
                        </svg>
                        <span>{feature}</span>
                      </li>
                    ))}
                  </ul>
                  <div class="mt-5 flex items-center justify-between gap-3 border-t border-border pt-4 dark:border-darkmode-border">
                    <p class="text-2xl font-extrabold text-text-dark dark:text-darkmode-text-dark">
                      {module.price}
                    </p>
                    <a
                      class="btn btn-outline-primary module-btn inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold whitespace-nowrap transition-all duration-300 hover:-translate-y-0.5"
                      href={module.link}
                    >
                      Подробнее
                      <svg
                        aria-hidden="true"
                        class="h-[0.9em] w-[0.9em] shrink-0"
                      >
                        <use xlink:href="#icon-FaArrowRight" />
                      </svg>
                    </a>
                  </div>
                </div>
              </article>
            </div>
          ))
        }
      </div>
    </div>
  </section>
  <!-- /Modules -->

  <!-- Platform -->
  <section class="section-sm bg-gradient" id="platform">
    <div class="container">
      <h2 class="mb-3 text-h3 text-text-dark dark:text-darkmode-text-dark">
        {homepage.platform.title}
      </h2>
      <p class="mb-8 max-w-3xl text-lg">{homepage.platform.subtitle}</p>
      <div
        class="row items-center gap-y-8 rounded-3xl border border-border bg-body p-6 shadow-sm dark:border-darkmode-border dark:bg-darkmode-light md:p-10"
      >
        <div class="lg:col-5">
          <div class="overflow-hidden rounded-2xl">
            <ImageMod
              src={homepage.platform.image}
              width={1000}
              height={700}
              alt={homepage.platform.imageAlt}
              class="w-full h-auto object-contain rounded-2xl"
              format="webp"
            />
          </div>
        </div>
        <div class="lg:col-7">
          <h3
            class="mb-5 text-xl font-bold text-text-dark dark:text-darkmode-text-dark"
          >
            Платформа
          </h3>
          <ul class="grid gap-3">
            {
              homepage.platform.points.map((point: string) => (
                <li class="flex items-start gap-2 text-sm leading-relaxed">
                  <svg
                    aria-hidden="true"
                    class="mt-1 h-[1em] w-[1em] shrink-0 text-primary"
                  >
                    <use xlink:href="#icon-FaCheck" />
                  </svg>
                  <span>{point}</span>
                </li>
              ))
            }
          </ul>
          <div
            class="mt-6 border-t border-border pt-5 dark:border-darkmode-border"
          >
            <h4
              class="mb-3 text-sm font-bold uppercase tracking-wide text-text-dark dark:text-darkmode-text-dark"
            >
              Технологический стек
            </h4>
            <div class="grid gap-x-8 gap-y-2 sm:grid-cols-2">
              <dl class="space-y-1.5">
                <dt
                  class="text-xs font-bold uppercase tracking-wide text-text-light dark:text-darkmode-text-light"
                >
                  Back-end
                </dt>
                <dd class="text-sm">Язык: Python</dd>
                <dd class="text-sm">Шина данных: RabbitMQ</dd>
                <dd class="text-sm">Веб-сервер: Nginx</dd>
                <dd class="text-sm">Фреймворки: SqlAlchemy, Flask</dd>
                <dd class="text-sm">Форматы: MessagePack, JSON</dd>
                <dd class="text-sm">
                  Основная БД: Postgres 14 (Patroni cluster)
                </dd>
                <dd class="text-sm">Вспомогательная БД: Redis, etcd</dd>
                <dd class="text-sm">Оркестрация: Kubernetes</dd>
                <dd class="text-sm">
                  Мониторинг: Sentry, Prometheus, Loki, Grafana
                </dd>
              </dl>
              <dl class="space-y-1.5">
                <dt
                  class="text-xs font-bold uppercase tracking-wide text-text-light dark:text-darkmode-text-light"
                >
                  Frontend
                </dt>
                <dd class="text-sm">Язык: JavaScript</dd>
                <dd class="text-sm">Фреймворк: VueJS 2.5</dd>
              </dl>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- /Platform -->

  <!-- Sim card -->
  <section class="section-sm" id="sim">
    <div class="container">
      <h2 class="mb-3 text-h3 text-text-dark dark:text-darkmode-text-dark">
        {homepage.sim.title}
      </h2>
      <p class="mb-8 max-w-3xl text-lg">{homepage.sim.subtitle}</p>
      <div class="row mt-8 items-center gap-y-6">
        <div class="lg:col-4">
          <div
            class="h-full rounded-3xl border border-border bg-body p-6 flex flex-col shadow-sm dark:border-darkmode-border dark:bg-darkmode-light"
          >
            <div class="flex-1">
              <h3
                class="mb-4 flex items-center gap-2 text-lg font-bold text-text-dark dark:text-darkmode-text-dark"
              >
                <svg
                  aria-hidden="true"
                  class="h-[1em] w-[1em] fill-current text-primary"
                >
                  <use xlink:href="#icon-FaBroadcastTower"></use>
                </svg>
                <span>{homepage.sim.vsLoraWan.title}</span>
              </h3>
              <ul class="space-y-2.5">
                {
                  homepage.sim.vsLoraWan.points.map((point: string) => (
                    <li class="flex items-start gap-2 text-sm leading-relaxed">
                      <svg
                        aria-hidden="true"
                        class="mt-1 h-[1em] w-[1em] shrink-0 text-primary"
                      >
                        <use xlink:href="#icon-FaCheck" />
                      </svg>
                      <span>{point}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>
        <div class="lg:col-4">
          <div
            class="h-full rounded-3xl border border-emerald-300 bg-linear-to-br from-emerald-50 to-white p-6 text-center shadow-sm dark:border-emerald-500/40 dark:from-darkmode-light dark:to-darkmode-body md:p-8"
          >
            <span
              class="inline-flex rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.14em] text-emerald-600"
            >
              {homepage.sim.tariff.name}
            </span>
            <p
              class="mt-3 text-4xl font-extrabold text-text-dark dark:text-darkmode-text-dark"
            >
              {homepage.sim.tariff.price}
            </p>
            <p
              class="mt-1 text-sm text-text-light dark:text-darkmode-text-light"
            >
              {homepage.sim.tariff.priceNote}
            </p>
            <ul class="mt-4 space-y-2 text-left">
              {
                homepage.sim.tariff.features.map((feature: string) => (
                  <li class="flex items-start gap-2 text-sm leading-relaxed">
                    <svg
                      aria-hidden="true"
