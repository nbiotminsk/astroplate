---
import ImageMod from "@/components/ImageMod.astro";
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser.astro";
import JsonLd from "@/components/JsonLd.astro";
const siteUrl = "https://teleofis24.by";

const homepageEntry = await getListPage("homepage", "-index");
const homepage = homepageEntry.data as any;
---

<Base
  title={homepage.title}
  meta_title={homepage.meta_title}
  description={homepage.description}
  hideBreadcrumbs={true}
>
  <Fragment slot="head">
    <JsonLd
      type="Product"
      data={{
        name: "Радиомодем 2576 NB-IoT",
        image: `${siteUrl}/images/radiomodem-2576-photo.png`,
        description:
          "Радиомодем 2576 NB-IoT для дистанционной передачи показаний счётчиков воды на платформу UNICBOARD и УП «Минскводоканал». 2 импульсных входа, IP65/IP68, батарея 3,6 В, протокол SMP-M.",
        brand: { "@type": "Brand", name: "Nero Electronics" },
        mpn: "45.03.0001.222.00",
        sku: "radiomodem-2576",
        offers: {
          "@type": "Offer",
          url: `${siteUrl}/store/radiomodem-2576-ver-2/`,
          priceCurrency: "BYN",
          price: "455",
          priceValidUntil: "2027-12-31",
          availability: "https://schema.org/InStock",
          itemCondition: "https://schema.org/NewCondition",
          seller: {
            "@type": "Organization",
            name: "Частное предприятие «Телеофис»",
          },
        },
      }}
    />

    <JsonLd
      type="FAQPage"
      data={{
        mainEntity: homepage.faq.items.map((item: any) => ({
          "@type": "Question",
          name: item.question,
          acceptedAnswer: {
            "@type": "Answer",
            text: item.answer,
          },
        })),
      }}
    />

    <JsonLd
      type="LocalBusiness"
      data={{
        name: "ЧАСТНОЕ ПРЕДПРИЯТИЕ «ТЕЛЕОФИС»",
        image: `${siteUrl}/images/og-image.png`,
        "@id": `${siteUrl}/#organization`,
        url: siteUrl,
        telephone: "+375298462462",
        email: "info@teleofis24.by",
        priceRange: "$$",
        currenciesAccepted: "BYN",
        paymentAccepted: "ЕРИП, безналичный расчёт",
        address: {
          "@type": "PostalAddress",
          streetAddress: "ул. Макаёнка, 12г, пом. 257",
          addressLocality: "Минск",
          postalCode: "220114",
          addressCountry: "BY",
        },
        geo: {
          "@type": "GeoCoordinates",
          latitude: 53.9248,
          longitude: 27.6256,
        },
        areaServed: { "@type": "Country", name: "Беларусь" },
        openingHoursSpecification: {
          "@type": "OpeningHoursSpecification",
          dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          opens: "13:30",
          closes: "15:30",
        },
        sameAs: ["https://t.me/teleofis_by"],
      }}
    />
  </Fragment>

  <!-- Pricing -->
  <section class="section pb-16 pt-12">
    <div class="container">
      <div class="mx-auto max-w-2xl text-center">
        <h1 class="mb-5 text-h4 leading-tight md:text-h3">
          {homepage.pricing.title}
        </h1>
        <p class="text-lg">{homepage.pricing.subtitle}</p>
      </div>
      <div class="row mt-10 items-stretch gap-y-6">
        {
          homepage.pricing.cards.map((card: any, idx: number) => (
            <div
              class={`md:col-4 ${card.featured ? "lg:order-2" : ""} ${
                idx === 0 ? "lg:order-1" : idx === 2 ? "lg:order-3" : ""
              }`}
            >
              <article
                class={`info-card flex h-full flex-col p-6 text-left ${
                  card.featured
                    ? "border-2 border-primary bg-primary/5 shadow-xl md:p-8"
                    : ""
                }`}
              >
                <div class="flex items-start justify-between gap-3">
                  <h2
                    class="text-xl font-bold text-text-dark dark:text-darkmode-text-dark"
                  >
                    {card.name}
                  </h2>
                  {card.tag && (
                    <span class="inline-flex shrink-0 rounded-full border border-primary/30 bg-primary/10 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.1em] text-primary dark:border-darkmode-primary/40 dark:bg-darkmode-primary/15 dark:text-darkmode-primary">
                      {card.tag}
                    </span>
                  )}
                </div>
                <div class="mt-4">
                  <p class="text-3xl font-extrabold text-text dark:text-darkmode-text">
                    {card.price}
                  </p>
                  {card.priceNote && (
                    <p class="mt-1 text-sm text-text-light dark:text-darkmode-text-light">
                      {card.priceNote}
                    </p>
                  )}
                </div>
                <ul class="mt-5 flex-1 space-y-2.5">
                  {card.features.map((feature: any) => {
                    const isLink = typeof feature === "object" && feature?.link;
                    const text = isLink ? feature.text : feature;
                    return (
                      <li class="flex items-start gap-2 text-sm leading-relaxed">
                        <svg class="mt-1 h-[1em] w-[1em] shrink-0 text-primary">
                          <use xlink:href="#icon-FaCheck" />
                        </svg>
                        {isLink ? (
                          <a href={feature.link} class="font-semibold text-primary underline-offset-2 hover:underline">
                            {text}
                          </a>
                        ) : (
                          <span>{text}</span>
                        )}
                      </li>
                    );
                  })}
                </ul>
                <div class="mt-6">
                  <a
                    class={`btn w-full justify-center ${
                      card.featured
                        ? "btn-primary bg-linear-to-r from-primary to-blue-700 shadow-lg shadow-primary/30 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-primary/40 active:scale-95"
                        : "btn-outline-primary transition-all duration-300 hover:-translate-y-1 active:scale-95"
                    }`}
                    href={card.cta.link}
                    {...(card.cta.link.startsWith("http")
                      ? { target: "_blank", rel: "noopener" }
                      : {})}
                  >
                    {card.cta.label}
                  </a>
                </div>
              </article>
            </div>
          ))
        }
      </div>
    </div>
  </section>
  <!-- /Pricing -->

  <!-- How it works -->
  <section class="section-sm bg-gradient" id="flow">
    <div class="container">
      <h2 class="mb-3 text-h3 text-text-dark dark:text-darkmode-text-dark">
        {homepage.flow.title}
      </h2>
      <p class="mb-8 max-w-2xl text-lg">{homepage.flow.subtitle}</p>
      <div class="row gap-y-4">
        {
          homepage.flow.steps.map((step: any, idx: number) => (
            <div class="sm:col-6 lg:col-3">
              <div class="flex h-full items-start gap-3 rounded-2xl border border-border bg-body p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md dark:border-darkmode-border dark:bg-darkmode-light">
                <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-primary bg-primary text-xs font-semibold text-white shadow-sm dark:border-darkmode-primary dark:bg-darkmode-primary dark:text-text-dark">
                  {idx + 1}
                </span>
                <div class="min-w-0">
                  <p class="flex items-center gap-2 text-sm font-semibold text-text-dark dark:text-darkmode-text-dark">
                    <svg class="h-[1em] w-[1em] shrink-0 fill-current text-primary dark:text-darkmode-primary">
                      <use xlink:href={`#icon-${step.icon}`} />
                    </svg>
                    <span>{step.title}</span>
                  </p>
                  <p class="mt-1 text-xs leading-relaxed">{step.text}</p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
  <!-- /How it works -->

  <!-- Modules -->
  <section class="section-sm" id="modules">
    <div class="container">
      <h2 class="mb-3 text-h3 text-text-dark dark:text-darkmode-text-dark">
        {homepage.modules.title}
      </h2>
      <p class="mb-8 max-w-3xl text-lg">{homepage.modules.subtitle}</p>
      <div class="row gap-y-6">
        {
          homepage.modules.items.map((module: any) => (
            <div class="md:col-4">
<article
                  class="info-card module-card flex h-full flex-col !p-0 text-left"
                  style={`border-color: ${module.borderColor}; --card-color: ${module.borderColor}`}
                >
                  <a
                    href={module.link}
                    class="group block h-[200px] overflow-hidden rounded-t-2xl bg-white dark:bg-darkmode-body"
                    aria-label={module.title}
                  >
                    <ImageMod
                      src={module.image}
                      width={640}
                      height={480}
                      alt={module.title}
                      class="h-full w-full object-contain transition-transform duration-300 group-hover:scale-110"
                      format="webp"
                    />
                  </a>
                <div class="flex flex-1 flex-col p-6">
                  <div class="flex items-center justify-between gap-3">
                    <h3 class="card-title text-text-dark dark:text-darkmode-text-dark">
                      {module.title}
                    </h3>
                    <span class="inline-flex shrink-0 rounded-full border border-primary/30 bg-primary/10 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.1em] text-primary dark:border-darkmode-primary/40 dark:bg-darkmode-primary/15 dark:text-darkmode-primary">
                      {module.tag}
                    </span>
                  </div>
                  <p class="mt-1 text-sm leading-relaxed">{module.subtitle}</p>
                  <ul class="mt-4 flex-1 space-y-2.5">
                    {module.features.map((feature: string) => (
                      <li class="flex items-start gap-2 text-sm leading-relaxed">
                        <svg class="mt-1 h-[1em] w-[1em] shrink-0 text-primary">
                          <use xlink:href="#icon-FaCheck" />
                        </svg>
                        <span>{feature}</span>
                      </li>
                    ))}
                  </ul>
                  <div class="mt-5 flex items-center justify-between gap-3 border-t border-border pt-4 dark:border-darkmode-border">
                    <p class="text-2xl font-extrabold text-text-dark dark:text-darkmode-text-dark">
                      {module.price}
                    </p>
                    <a
                      class="btn btn-outline-primary module-btn inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold whitespace-nowrap transition-all duration-300 hover:-translate-y-0.5"
                      href={module.link}
                    >
                      Подробнее
                      <svg class="h-[0.9em] w-[0.9em] shrink-0">
                        <use xlink:href="#icon-FaArrowRight" />
                      </svg>
                    </a>
                  </div>
                </div>
              </article>
            </div>
          ))
        }
      </div>
    </div>
  </section>
  <!-- /Modules -->

  <!-- Platform -->
  <section class="section-sm bg-gradient" id="platform">
    <div class="container">
      <h2 class="mb-3 text-h3 text-text-dark dark:text-darkmode-text-dark">
        {homepage.platform.title}
      </h2>
      <p class="mb-8 max-w-3xl text-lg">{homepage.platform.subtitle}</p>
      <div
        class="row items-center gap-y-8 rounded-3xl border border-border bg-body p-6 shadow-sm dark:border-darkmode-border dark:bg-darkmode-light md:p-10"
      >
        <div class="lg:col-5">
          <div class="overflow-hidden rounded-2xl">
            <ImageMod
              src={homepage.platform.image}
              width={1000}
              height={700}
              alt={homepage.platform.imageAlt}
              class="w-full h-auto object-contain rounded-2xl"
              format="webp"
            />
          </div>
        </div>
        <div class="lg:col-7">
          <h3
            class="mb-5 text-xl font-bold text-text-dark dark:text-darkmode-text-dark"
          >
            Платформа
          </h3>
          <ul class="grid gap-3">
            {
              homepage.platform.points.map((point: string) => (
                <li class="flex items-start gap-2 text-sm leading-relaxed">
                  <svg class="mt-1 h-[1em] w-[1em] shrink-0 text-primary">
                    <use xlink:href="#icon-FaCheck" />
                  </svg>
                  <span>{point}</span>
                </li>
              ))
            }
          </ul>
          <div class="mt-6 border-t border-border pt-5 dark:border-darkmode-border">
            <h4
              class="mb-3 text-sm font-bold uppercase tracking-wide text-text-dark dark:text-darkmode-text-dark"
            >
              Технологический стек
            </h4>
            <div class="grid gap-x-8 gap-y-2 sm:grid-cols-2">
              <dl class="space-y-1.5">
                <dt class="text-xs font-bold uppercase tracking-wide text-text-light dark:text-darkmode-text-light">
                  Back-end
                </dt>
                <dd class="text-sm">Язык: Python</dd>
                <dd class="text-sm">Шина данных: RabbitMQ</dd>
                <dd class="text-sm">Веб-сервер: Nginx</dd>
                <dd class="text-sm">Фреймворки: SqlAlchemy, Flask</dd>
                <dd class="text-sm">Форматы: MessagePack, JSON</dd>
                <dd class="text-sm">Основная БД: Postgres 14 (Patroni cluster)</dd>
                <dd class="text-sm">Вспомогательная БД: Redis, etcd</dd>
                <dd class="text-sm">Оркестрация: Kubernetes</dd>
                <dd class="text-sm">Мониторинг: Sentry, Prometheus, Loki, Grafana</dd>
              </dl>
              <dl class="space-y-1.5">
                <dt class="text-xs font-bold uppercase tracking-wide text-text-light dark:text-darkmode-text-light">
                  Frontend
                </dt>
                <dd class="text-sm">Язык: JavaScript</dd>
                <dd class="text-sm">Фреймворк: VueJS 2.5</dd>
              </dl>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- /Platform -->

  <!-- Sim card -->
  <section class="section-sm" id="sim">
    <div class="container">
      <h2 class="mb-3 text-h3 text-text-dark dark:text-darkmode-text-dark">
        {homepage.sim.title}
      </h2>
      <p class="mb-8 max-w-3xl text-lg">{homepage.sim.subtitle}</p>
      <div class="row mt-8 items-center gap-y-6">
        <div class="lg:col-4">
          <div
            class="h-full rounded-3xl border border-border bg-body p-6 flex flex-col shadow-sm dark:border-darkmode-border dark:bg-darkmode-light"
          >
            <div class="flex-1">
              <h3
                class="mb-4 flex items-center gap-2 text-lg font-bold text-text-dark dark:text-darkmode-text-dark"
              >
                <svg class="h-[1em] w-[1em] fill-current text-primary">
                  <use xlink:href="#icon-FaBroadcastTower"></use>
                </svg>
                <span>{homepage.sim.vsLoraWan.title}</span>
              </h3>
              <ul class="space-y-2.5">
                {
                  homepage.sim.vsLoraWan.points.map((point: string) => (
                    <li class="flex items-start gap-2 text-sm leading-relaxed">
                      <svg class="mt-1 h-[1em] w-[1em] shrink-0 text-primary">
                        <use xlink:href="#icon-FaCheck" />
                      </svg>
                      <span>{point}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>
        <div class="lg:col-4">
          <div
            class="h-full rounded-3xl border border-emerald-300 bg-linear-to-br from-emerald-50 to-white p-6 text-center shadow-sm dark:border-emerald-500/40 dark:from-darkmode-light dark:to-darkmode-body md:p-8"
          >
            <span
              class="inline-flex rounded-full border border-emerald-500/30 bg-emerald-500/10 px-3 py-1 text-[11px] font-bold uppercase tracking-[0.14em] text-emerald-600"
            >
              {homepage.sim.tariff.name}
            </span>
            <p
              class="mt-3 text-4xl font-extrabold text-text-dark dark:text-darkmode-text-dark"
            >
              {homepage.sim.tariff.price}
            </p>
            <p
              class="mt-1 text-sm text-text-light dark:text-darkmode-text-light"
            >
              {homepage.sim.tariff.priceNote}
            </p>
            <ul class="mt-4 space-y-2 text-left">
              {
                homepage.sim.tariff.features.map((feature: string) => (
                  <li class="flex items-start gap-2 text-sm leading-relaxed">
                    <svg class="mt-1 h-[1em] w-[1em] shrink-0 text-emerald-500">
                      <use xlink:href="#icon-FaCheck" />
                    </svg>
                    <span>{feature}</span>
                  </li>
                ))
              }
            </ul>
            <a
              class="btn btn-primary mt-5 mx-auto w-full max-w-xs justify-center text-center bg-linear-to-r from-emerald-500 to-emerald-600 border-emerald-500 text-white shadow-[0_10px_20px_rgba(16,185,129,0.18)] transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_14px_28px_rgba(16,185,129,0.26)] active:scale-95"
              href={homepage.sim.tariff.cta.link}
              target="_blank"
              rel="noopener"
            >
              {homepage.sim.tariff.cta.label}
            </a>
          </div>
        </div>
        <div class="lg:col-4">
          <div
            class="h-full rounded-3xl border border-border bg-body p-6 flex flex-col shadow-sm dark:border-darkmode-border dark:bg-darkmode-light"
          >
            <div class="flex-1">
              <h3
                class="mb-4 flex items-center gap-2 text-lg font-bold text-text-dark dark:text-darkmode-text-dark"
              >
                <svg class="h-[1em] w-[1em] fill-current text-primary">
                  <use xlink:href="#icon-FaMobileAlt"></use>
                </svg>
                <span>{homepage.sim.vsGsm.title}</span>
              </h3>
              <ul class="space-y-2.5">
                {
                  homepage.sim.vsGsm.points.map((point: string) => (
                    <li class="flex items-start gap-2 text-sm leading-relaxed">
                      <svg class="mt-1 h-[1em] w-[1em] shrink-0 text-primary">
                        <use xlink:href="#icon-FaCheck" />
                      </svg>
                      <span>{point}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- /Sim card -->

  <!-- Meters -->
  <section class="section-sm bg-gradient" id="meters">
    <div class="container">
      <h2 class="mb-3 text-h3 text-text-dark dark:text-darkmode-text-dark">
        {homepage.meters.title}
      </h2>
      <p class="mb-8 max-w-3xl text-lg">{homepage.meters.subtitle}</p>
      <div class="row gap-y-6">
        {
          homepage.meters.items.map((meter: any) => (
            <div class="md:col-6 lg:col-4">
              <article class="info-card flex h-full flex-col !p-0 text-left">
                <div class="flex h-[275px] items-center justify-center overflow-hidden bg-white dark:bg-darkmode-body">
                  <ImageMod
                    src={meter.image}
                    width={640}
                    height={480}
                    alt={meter.title}
                    class="h-full w-auto max-w-full object-contain"
                    format="webp"
                  />
                </div>
                <div class="p-6">
                  <h3 class="card-title text-text-dark dark:text-darkmode-text-dark">
                    {meter.title}
                  </h3>
                  <p class="mt-2 text-sm leading-relaxed">{meter.text}</p>
                </div>
              </article>
            </div>
          ))
        }
      </div>
      <p
        class="mt-8 flex items-start gap-2 rounded-2xl border border-border bg-body p-4 text-sm leading-relaxed dark:border-darkmode-border dark:bg-darkmode-light"
      >
        <svg class="mt-1 h-[1em] w-[1em] shrink-0 text-primary">
          <use xlink:href="#icon-FaCheck"></use>
        </svg>
        <span>{homepage.meters.note}</span>
      </p>
    </div>
  </section>
  <!-- /Meters -->

  <section class="section-sm">
    <div class="container">
      <div class="final-cta-block text-center">
        <h2 class="text-h3 text-text-dark dark:text-darkmode-text-dark">
          {homepage.finalCta.title}
        </h2>
        <p class="mt-3 text-lg">{homepage.finalCta.text}</p>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <a class="btn btn-primary" href={homepage.finalCta.primary.link}>
            {homepage.finalCta.primary.label}
          </a>
          <a
            class="btn btn-outline-primary"
            href={homepage.finalCta.secondary.link}
          >
            <svg class="mr-2 inline h-[1em] w-[1em]">
              <use xlink:href="#icon-FaPhoneAlt"></use>
            </svg>
            {homepage.finalCta.secondary.label}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-sm pt-0">
    <div class="container">
      <h2 class="mb-8 text-h3 text-text-dark dark:text-darkmode-text-dark">
        {homepage.faq.title}
      </h2>
      <div class="faq-list">
        {
          homepage.faq.items.map((item: any, idx: number) => (
            <details class="faq-item" open={idx === 0}>
              <summary class="faq-question">{item.question}</summary>
              <p class="faq-answer">{item.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .info-card.module-card .module-btn:hover {
    background: color-mix(in srgb, var(--card-color) 14%, transparent);
    border-color: var(--card-color);
    color: var(--card-color);
  }
</style>
