---
import Base from "@/layouts/Base.astro";
import CallToAction from "@/components/CallToAction.astro";
import { getSinglePage } from "@/lib/contentParser.astro";
import PageHeader from "@/partials/PageHeader.astro";

const pages = await getSinglePage("pages");
const serviceArticles = pages.sort((a, b) =>
  a.data.title.localeCompare(b.data.title),
);
---

<Base
  title="Услуги"
  meta_title="Услуги"
  description="Каталог услуг компании Телеофис: установка и настройка систем дистанционного сбора показаний, ремонт модулей Zeta, замена счетчиков воды и техническая поддержка в Беларуси."
>
  <PageHeader title="Услуги" compact={true} />

  <section
    class="py-12 xl:py-16 bg-gradient-to-b from-body via-light/10 to-body dark:from-darkmode-body dark:via-darkmode-light/5 dark:to-darkmode-body"
  >
    <div class="container">
      <div class="row justify-center">
        <div class="lg:col-12 xl:col-10">
          {
            serviceArticles.length ? (
              <div class="row g-4 justify-center">
                {serviceArticles.map((article) => {
                  return (
                    <div class="mb-8 md:col-6 lg:col-4">
                      <article class="group relative flex h-full flex-col justify-between overflow-hidden rounded-2xl border border-border/40 bg-white/40 dark:bg-darkmode-light/10 backdrop-blur-md p-6 shadow-sm hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 ease-out before:absolute before:inset-0 before:rounded-2xl before:border before:border-white/10 before:pointer-events-none">
                        {/* Subtle top glow border */}
                        <div class="absolute inset-x-0 top-0 h-[3px] bg-gradient-to-r from-primary/20 via-primary to-primary/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300" />

                        {/* Soft background blob */}
                        <div class="absolute -right-8 -top-8 h-28 w-28 rounded-full bg-primary/5 blur-2xl group-hover:bg-primary/10 transition-all duration-300" />

                        {/* Top corner badge */}
                        <div class="absolute right-4 top-4 rounded-full bg-light/80 dark:bg-darkmode-light/50 border border-border/20 dark:border-darkmode-border/20 px-2.5 py-0.5 text-[9px] font-bold text-text-light dark:text-darkmode-text-light uppercase tracking-wider">
                          Услуга
                        </div>

                        <div>
                          {/* Premium Icon Container */}
                          <div class="relative mb-5 inline-flex items-center justify-center rounded-2xl bg-gradient-to-br from-primary/10 via-primary/5 to-blue-500/5 dark:from-primary/20 dark:via-primary/10 dark:to-blue-500/10 p-4 w-14 h-14 border border-primary/10 group-hover:border-primary/30 transition-all duration-300 ease-out">
                            {/* Icon micro-glow on hover */}
                            <div class="absolute -inset-1 rounded-2xl bg-primary/15 blur-md opacity-0 group-hover:opacity-100 transition-opacity duration-300" />

                            <svg
                              class="relative h-7 w-7 text-primary group-hover:scale-110 transition-transform duration-300"
                              aria-hidden="true"
                            >
                              <use
                                xlink:href={`#icon-${article.data.icon || "FaTools"}`}
                              />
                            </svg>
                          </div>

                          <h3 class="h6 mb-2.5 font-bold line-clamp-2 pr-12">
                            <a
                              href={`/${article.id}`}
                              class="text-text-dark dark:text-darkmode-text-dark hover:text-primary transition-colors duration-200"
                            >
                              {article.data.title}
                            </a>
                          </h3>

                          {article.data.description && (
                            <p class="mb-4 text-xs md:text-sm text-text dark:text-darkmode-text/80 line-clamp-2 leading-relaxed">
                              {article.data.description}
                            </p>
                          )}
                        </div>

                        <div class="mt-auto pt-1">
                          <a
                            class="inline-flex items-center justify-center gap-2 btn btn-sm btn-outline-primary w-full py-2 text-xs font-bold uppercase tracking-wider rounded-xl backdrop-blur-sm group-hover:bg-primary group-hover:text-white transition-all duration-300"
                            href={`/${article.id}`}
                          >
                            Подробнее
                            <svg
                              xmlns="http://www.w3.org/2000/svg"
                              width="14"
                              height="14"
                              viewBox="0 0 24 24"
                              fill="none"
                              stroke="currentColor"
                              stroke-width="2.5"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              class="group-hover:translate-x-1 transition-transform duration-200"
                            >
                              <line x1="5" y1="12" x2="19" y2="12" />
                              <polyline points="12 5 19 12 12 19" />
                            </svg>
                          </a>
                        </div>
                      </article>
                    </div>
                  );
                })}
              </div>
            ) : (
              <p class="text-center text-text-light dark:text-darkmode-text-light py-10">
                Материалы пока не добавлены.
              </p>
            )
          }
        </div>
      </div>
      <CallToAction />
    </div>
  </section>
</Base>
