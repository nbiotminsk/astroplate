<script>
  import { addToCart } from "@/lib/cart";

  const initProductPage = () => {
    const addToCartButton = document.querySelector(
      "#add-to-cart",
    ) as HTMLButtonElement | null;
    const qtyInput = document.querySelector(
      "#detail-qty",
    ) as HTMLInputElement | null;

    if (!addToCartButton || addToCartButton.dataset.initialized === "true")
      return;
    addToCartButton.dataset.initialized = "true";

    // Services logic
    const services = [
      {
        id: "replacement",
        price: 80,
        title: "Услуга: Замена счетчика на объекте",
      },
      {
        id: "warranty",
        price: 100,
        title: "Услуга: Расширенная гарантия 24 мес",
      },
      { id: "battery", price: 40, title: "Дополнительная батарейка" },
      {
        id: "sim_card",
        price: 21,
        title: "СИМ-карта МТС NB-IoT (1 год)",
      },
      {
        id: "software_license",
        price: 44,
        title: "Лицензия ПО «Мой Клиент: Ресурсы» (1 год)",
      },
      {
        id: "module_config",
        price: 40,
        title: "Настройка и конфигурирование модуля",
      },
      {
        id: "platform_integration",
        price: 44,
        title: "Добавление модуля на платформу УП «Минскводоканал»",
      },
      {
        id: "standard_install",
        price: 106,
        title: "Подключение и монтаж «под ключ» (Стандарт)",
      },
      {
        id: "well_install",
        price: 176,
        title: "Подключение и монтаж в колодце",
      },
      {
        id: "urgent_install",
        price: 60,
        title: "Срочный монтаж (в течение 48 часов)",
      },
      {
        id: "delivery_minsk",
        price: 30,
        title: "Доставка по Минску (в пределах МКАД)",
      },
      {
        id: "delivery_suburb",
        price: 30,
        title: "Доставка за МКАД (пригород, +2 руб/км)",
      },
    ];

    services.forEach((service) => {
      const checkbox = document.getElementById(
        `service-${service.id}`,
      ) as HTMLInputElement | null;
      const qty = document.getElementById(
        `qty-${service.id}`,
      ) as HTMLInputElement | null;

      if (checkbox && qty) {
        checkbox.addEventListener("change", () => {
          qty.disabled = !checkbox.checked;
          if (checkbox.checked && qtyInput) {
            qty.value = qtyInput.value;
          }
        });
      }
    });

    // Handle select element states for dynamic services
    const simCheckbox = document.getElementById(
      "service-sim_card",
    ) as HTMLInputElement | null;
    const simSelect = document.getElementById(
      "select-sim_card",
    ) as HTMLSelectElement | null;
    if (simCheckbox && simSelect) {
      simCheckbox.addEventListener("change", () => {
        simSelect.disabled = !simCheckbox.checked;
      });
    }

    const licenseCheckbox = document.getElementById(
      "service-software_license",
    ) as HTMLInputElement | null;
    const licenseSelect = document.getElementById(
      "select-software_license",
    ) as HTMLSelectElement | null;
    if (licenseCheckbox && licenseSelect) {
      licenseCheckbox.addEventListener("change", () => {
        licenseSelect.disabled = !licenseCheckbox.checked;
      });
    }

    // Mutual exclusivity for Standard and Well installation
    const standardCheckbox = document.getElementById(
      "service-standard_install",
    ) as HTMLInputElement | null;
    const wellCheckbox = document.getElementById(
      "service-well_install",
    ) as HTMLInputElement | null;

    if (standardCheckbox && wellCheckbox) {
      standardCheckbox.addEventListener("change", () => {
        if (standardCheckbox.checked) {
          wellCheckbox.checked = false;
          const wellQty = document.getElementById(
            "qty-well_install",
          ) as HTMLInputElement | null;
          if (wellQty) wellQty.disabled = true;
        }
      });

      wellCheckbox.addEventListener("change", () => {
        if (wellCheckbox.checked) {
          standardCheckbox.checked = false;
          const standardQty = document.getElementById(
            "qty-standard_install",
          ) as HTMLInputElement | null;
          if (standardQty) standardQty.disabled = true;
        }
      });
    }

    // Mutual exclusivity for Delivery Minsk and Suburb
    const deliveryMinskCheckbox = document.getElementById(
      "service-delivery_minsk",
    ) as HTMLInputElement | null;
    const deliverySuburbCheckbox = document.getElementById(
      "service-delivery_suburb",
    ) as HTMLInputElement | null;

    if (deliveryMinskCheckbox && deliverySuburbCheckbox) {
      deliveryMinskCheckbox.addEventListener("change", () => {
        if (deliveryMinskCheckbox.checked) {
          deliverySuburbCheckbox.checked = false;
          const suburbQty = document.getElementById(
            "qty-delivery_suburb",
          ) as HTMLInputElement | null;
          if (suburbQty) suburbQty.disabled = true;
        }
      });

      deliverySuburbCheckbox.addEventListener("change", () => {
        if (deliverySuburbCheckbox.checked) {
          deliveryMinskCheckbox.checked = false;
          const minskQty = document.getElementById(
            "qty-delivery_minsk",
          ) as HTMLInputElement | null;
          if (minskQty) minskQty.disabled = true;
        }
      });
    }

    // Sync service quantity with main quantity if enabled
    qtyInput?.addEventListener("change", () => {
      services.forEach((service) => {
        const checkbox = document.getElementById(
          `service-${service.id}`,
        ) as HTMLInputElement | null;
        const qty = document.getElementById(
          `qty-${service.id}`,
        ) as HTMLInputElement | null;
        if (checkbox?.checked && qty) {
          qty.value = qtyInput.value;
        }
      });
    });

    addToCartButton.addEventListener("click", () => {
      const id = addToCartButton.dataset.id;
      if (!id) return;
      const title = addToCartButton.dataset.title || "";
      const price = Number(addToCartButton.dataset.price || 0);
      const category = addToCartButton.dataset.cartCategory || "";
      const quantity = Math.max(1, Number(qtyInput?.value || 1));

      // Add main product
      addToCart({ id, title, price, category, quantity });

      // Add services
      services.forEach((service) => {
        const checkbox = document.getElementById(
          `service-${service.id}`,
        ) as HTMLInputElement | null;
        const qty = document.getElementById(
          `qty-${service.id}`,
        ) as HTMLInputElement | null;

        if (checkbox?.checked) {
          const serviceQty = Math.max(1, Number(qty?.value || 1));

          let servicePrice = service.price;
          let serviceTitle = service.title;

          if (service.id === "sim_card" && simSelect) {
            servicePrice = Number(simSelect.value);
            const opt = simSelect.options[simSelect.selectedIndex];
            serviceTitle = opt.getAttribute("data-title") || service.title;
          } else if (service.id === "software_license" && licenseSelect) {
            servicePrice = Number(licenseSelect.value);
            const opt = licenseSelect.options[licenseSelect.selectedIndex];
            serviceTitle = opt.getAttribute("data-title") || service.title;
          }

          addToCart({
            id: `service-${service.id}-${id}`, // Unique ID for service related to this product
            title: serviceTitle,
            price: servicePrice,
            quantity: serviceQty,
          });
        }
      });

      document.dispatchEvent(new CustomEvent("cart:item-added"));
    });
  };

  const scheduleProductInit = () => {
    requestAnimationFrame(() => initProductPage());
  };

  scheduleProductInit();
  document.addEventListener("DOMContentLoaded", scheduleProductInit);
</script>
