---
import config from "@/config/config.json";
import { markdownify } from "@/lib/utils/textConverter";

const { enable, content, expire_days } = config.announcement;

// If disabled or no content, render nothing (no JS at all)
if (!enable || !content) {
  return;
}

const htmlContent = markdownify(content);
---

<div
  id="announcement-bar"
  class="relative z-999 bg-body dark:bg-darkmode-body shadow-[1px_0_10px_7px_rgba(154,154,154,0.11)] px-4 py-4 pr-12 md:text-lg transition-all duration-300 w-full"
>
  <p set:html={htmlContent} />
  <button
    id="announcement-close"
    class="absolute top-1/2 right-4 -translate-y-1/2 cursor-pointer flex items-center justify-center w-7 h-7 border border-border dark:border-darkmode-border rounded-full text-xl transition-colors duration-200"
    aria-label="Close announcement"
  >
    &times;
  </button>
</div>

<script is:inline define:vars={{ expire_days }}>
  const bar = document.getElementById("announcement-bar");
  const btn = document.getElementById("announcement-close");

  // Check cookie
  const cookieName = "announcement-close";
  const hasCookie = document.cookie
    .split("; ")
    .some((c) => c.startsWith(cookieName + "="));

  if (hasCookie) {
    bar?.remove();
  }

  btn?.addEventListener("click", () => {
    // Set cookie
    const expires = new Date(Date.now() + expire_days * 864e5).toUTCString();
    document.cookie = `${cookieName}=true; path=/; expires=${expires}`;
    bar?.remove();
  });
</script>
